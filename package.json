{
  "name": "ionic-photo-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform photo gallery built with Ionic, Vue 3 and Capacitor 8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "ionicons": "^8.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vue-tsc": "^2.1.10"
  }
}
